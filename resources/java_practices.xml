<?xml version="1.0"?>

<ruleset name="Sample rule set for PMD"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        Sample rule set for PMD, and the rules the SwCOE team follows.
    </description>

    <!-- This used to be ~1800 lines of rules hand-copied out of PMD 6's own
         category/java/bestpractices.xml, with the XPath rules written against
         the PMD 6 Java AST (PrimaryPrefix, PrimarySuffix, Name/@Image,
         ClassOrInterfaceDeclaration, AllocationExpression ...). PMD 7 rewrote
         that AST, so none of those expressions match anything any more - the
         ruleset loads with zero rules and reports zero violations rather than
         failing, which is the worst way for a quality gate to break. PMD 6.55
         warned about this itself ("does not mention attribute language='java',
         please mention it explicitly to be compatible with PMD 7").

         Referencing the category directly gets the maintained versions of the
         same rules, including the ones PMD 7 renamed or merged (for instance
         PositionLiteralsFirstInComparisons and its case-insensitive twin are
         now the single rule LiteralsFirstInComparisons). -->
    <rule ref="category/java/bestpractices.xml"/>

    <!-- Kept from the original copy, which tightened both thresholds well
         past PMD's defaults of 80 and 10. -->
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="classReportLevel" value="30"/>
            <property name="methodReportLevel" value="3"/>
        </properties>
    </rule>

</ruleset>
